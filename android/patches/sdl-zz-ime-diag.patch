+/*
+ * CloudpilotEmu diagnostic build only (verify/android-ime-diag): records what the IME sends and
+ * what reaches SDL (and so the Palm application), without the typed text: call, key code, editable
+ * length, selection / composing span and character classes (key = TG50 keyboard character, other =
+ * anything else, e.g. Hangul). Logged as cp-ime and kept as the last 60 entries in
+ * files/ime-diag.txt, which the start screen shows.
+ */
+class SDLImeDiag {
+    private static final int MAX = 60;
+    private static final java.util.ArrayDeque<String> lines = new java.util.ArrayDeque<>();
+    private static int seq = 0;
+    private static long start = 0;
+
+    static String classes(CharSequence text) {
+        if (text == null) return "null";
+        int key = 0, other = 0;
+        for (int i = 0; i < text.length(); ) {
+            int c = Character.codePointAt(text, i);
+            if (SDLInputConnection.isKeyChar(c)) key++; else other++;
+            i += Character.charCount(c);
+        }
+        return "len " + text.length() + " (key " + key + ", other " + other + ")";
+    }
+
+    private static String state(Editable e) {
+        if (e == null) return "";
+        return " | box " + e.length() + " sel " + Selection.getSelectionStart(e) + "-" + Selection.getSelectionEnd(e)
+            + " comp " + BaseInputConnection.getComposingSpanStart(e) + "-" + BaseInputConnection.getComposingSpanEnd(e);
+    }
+
+    static void key(String where, KeyEvent ev, Editable e) {
+        String action = ev.getAction() == KeyEvent.ACTION_DOWN ? "down" : ev.getAction() == KeyEvent.ACTION_UP ? "up" : "act" + ev.getAction();
+        add(where + " " + action + " " + KeyEvent.keyCodeToString(ev.getKeyCode()) + " rep " + ev.getRepeatCount()
+            + " src 0x" + Integer.toHexString(ev.getSource()) + state(e));
+    }
+
+    static void call(String where, String args, Editable e) {
+        add(where + "(" + args + ")" + state(e));
+    }
+
+    static void after(String where, boolean result, Editable e) {
+        add("  " + where + " -> " + result + state(e) + " (no updateText)");
+    }
+
+    static void update(int removed, int removedKey, int added, int addedKey, int before, int after, String note) {
+        add("  updateText: removed " + removed + " (key " + removedKey + " = BS to SDL), added "
+            + added + " (key " + addedKey + " = to SDL), committed " + before + " -> " + after + (note.isEmpty() ? "" : " " + note));
+    }
+
+    private static synchronized void add(String line) {
+        long now = android.os.SystemClock.uptimeMillis();
+        if (seq == 0) start = now;
+        seq++;
+        String entry = "#" + seq + " +" + (now - start) + "ms " + line;
+        Log.d("cp-ime", entry);
+        lines.addLast(entry);
+        while (lines.size() > MAX) lines.removeFirst();
+        write();
+    }
+
+    private static void write() {
+        Context context = SDL.getContext();
+        if (context == null) return;
+        StringBuilder b = new StringBuilder();
+        String ime = android.provider.Settings.Secure.getString(context.getContentResolver(),
+            android.provider.Settings.Secure.DEFAULT_INPUT_METHOD);
+        String version = "?";
+        try {
+            version = context.getPackageManager().getPackageInfo(context.getPackageName(), 0).versionName;
+        } catch (Exception ex) {
+        }
+        b.append("App ").append(version).append(", Android ").append(Build.VERSION.SDK_INT).append(", IME ").append(ime).append('\n');
+        for (String l : lines) b.append(l).append('\n');
+        java.io.File file = new java.io.File(context.getFilesDir(), "ime-diag.txt");
+        java.io.File tmp = new java.io.File(context.getFilesDir(), "ime-diag.txt.tmp");
+        try (java.io.FileOutputStream out = new java.io.FileOutputStream(tmp)) {
+            out.write(b.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        } catch (java.io.IOException ex) {
+            return;
+        }
+        tmp.renameTo(file);
+    }
+}
